# Copy this file to .env and fill in. NEVER commit .env to GitHub.
# Free Sepolia RPC: create an app at https://dashboard.alchemy.com (or Infura) -> copy the HTTPS URL
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
# Private key of a NEW MetaMask account used ONLY for this testnet project (starts with 0x)
PRIVATE_KEY=0xYOUR_TESTNET_ONLY_PRIVATE_KEY
# Optional: https://etherscan.io/myapikey  (lets you publish verified source code)
ETHERSCAN_API_KEY=
